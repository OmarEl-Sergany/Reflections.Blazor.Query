@implements IDisposable
@inject QueryRenderState DefaultState
@inject NavigationManager Navigation
@inject QueryMeasurementCoordinator Measurements
@inject QueryFormCoordinator Forms
@inject QueryElementRegistry Registry
<CascadingValue Value="ActiveState" IsFixed="true">@ChildContent</CascadingValue>
<style data-reflections-blazor-query="true">
    @@keyframes rbq-fade-in { from { opacity: 0; visibility: hidden; } to { opacity: 1; visibility: visible; } }
    @@keyframes rbq-fade-out { from { opacity: 1; visibility: visible; } to { opacity: 0; visibility: hidden; } }
    @@keyframes rbq-slide-down { from { height: 0; } to { height: var(--rbq-slide-height); } }
    @@keyframes rbq-slide-up { from { height: var(--rbq-slide-height); } to { height: 0; } }
    @foreach (var rule in ActiveState.Rules){<text>@rule.Selector { @rule.Property: @rule.Value; }</text>}
</style>
@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public QueryRenderState? RenderState { get; set; }
    [Parameter] public bool ClearOnNavigation { get; set; } = true;
    private QueryRenderState ActiveState => RenderState ?? DefaultState;

    protected override void OnInitialized()
    {
        ActiveState.Changed += OnStateChanged;
        ActiveState.RegisterDispatch(InvokeAsync);
        Measurements.Requested += OnMeasurementRequested;
        Forms.Requested += OnMeasurementRequested;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnMeasurementRequested() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Measurements.FlushAsync().AsTask();
        await Forms.FlushAsync().AsTask();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (ClearOnNavigation)
        {
            var virtualKeys = ActiveState.AllVirtualKeys;
            ActiveState.Clear();
            foreach (var key in virtualKeys)
                Registry.Unregister(key);
            Measurements.Invalidate(ActiveState);
            Forms.Invalidate(ActiveState);
        }
        if (!ClearOnNavigation)
            _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ActiveState.Changed -= OnStateChanged;
        ActiveState.UnregisterDispatch(InvokeAsync);
        Measurements.Requested -= OnMeasurementRequested;
        Forms.Requested -= OnMeasurementRequested;
        Navigation.LocationChanged -= OnLocationChanged;
        Measurements.Invalidate(ActiveState);
        Forms.Invalidate(ActiveState);
    }
}
