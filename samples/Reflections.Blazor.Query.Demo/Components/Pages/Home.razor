@page "/"
@rendermode InteractiveServer
@inject Query Query
@inject LayoutQuery LayoutQuery

<PageTitle>Reflections.Blazor.Query</PageTitle>
<h1>Reflections.Blazor.Query</h1>
<p>This page exercises CSS updates through the library after a Blazor event.</p>
<section class="debug-panel">
    <QueryElement TagName="p" ElementKey="home-paragraph-1" Class="query-item">First paragraph: unchanged.</QueryElement>
    <QueryElement TagName="p" ElementKey="home-paragraph-2" Class="query-item">Second paragraph: click the button to style me.</QueryElement>
    <QueryElement TagName="p" ElementKey="home-paragraph-3" Class="query-item">Third paragraph: unchanged.</QueryElement>
</section>
<button class="btn btn-primary" @onclick="ApplyStyle">Apply CSS</button>
@if (_applied)
{
    <p role="status">Style applied with <code>Query.Select(...).Css(...)</code>.</p>
}

@code {
    private bool _applied;
    private void ApplyStyle()
    {
        using (Query.BeginBatch())
        {
            Query.Select(".query-item").Eq(1).Css("color", "red");
            using (LayoutQuery.BeginBatch())
            {
                LayoutQuery.Select(".sidebar").Css("background", "black");
                LayoutQuery.Select(".top-row").Css("display", "none");
                LayoutQuery.Select(".page").Css("max-width", "1200px");
            }
        }

        _applied = true;
    }
}
