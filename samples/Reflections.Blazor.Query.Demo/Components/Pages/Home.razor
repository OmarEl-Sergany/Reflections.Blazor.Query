@page "/"
@rendermode InteractiveServer
@inject Query Query
@inject LayoutQuery LayoutQuery

<PageTitle>Reflections.Blazor.Query</PageTitle>
<h1>Reflections.Blazor.Query</h1>
<p>This page exercises CSS updates through the library after a Blazor event.</p>
<section class="debug-panel">
    <QueryElement TagName="p" ElementKey="home-paragraph-1" Class="query-item">First paragraph: unchanged.</QueryElement>
    <QueryElement TagName="p" ElementKey="home-paragraph-2" Class="query-item">Second paragraph: click the button to style me.</QueryElement>
    <QueryElement TagName="p" ElementKey="home-paragraph-3" Class="query-item">Third paragraph: unchanged.</QueryElement>
</section>
<button class="btn btn-primary" @onclick="ApplyStyle">Apply CSS</button>
<button class="btn btn-outline-primary ms-2" @onclick="MeasureTargetAsync">Measure target</button>
<button class="btn btn-outline-secondary ms-2" @onclick="MeasurePositionAsync">Measure position</button>
<button class="btn btn-outline-info ms-2" @onclick="ToggleSlide">Toggle slide</button>
<QueryElement TagName="p" ElementKey="home-slide-target" Class="slide-target">This paragraph exercises measured slide animation and Blazor-owned completion.</QueryElement>
@if (_applied)
{
    <p role="status">Style applied with <code>Query.Select(...).Css(...)</code>.</p>
}
@if (_measurement is not null)
{
    <p role="status">Target size: @_measurement.Value.Width px × @_measurement.Value.Height px.</p>
}
@if (_offset is not null)
{
    <p role="status">Target offset: @_offset.Left px, @_offset.Top px; position: @_position?.Left px, @_position?.Top px; owned offset parent: @(_offsetParent ?? "unavailable").</p>
}

@code {
    private bool _applied;
    private (double? Width, double? Height)? _measurement;
    private QueryPoint? _offset;
    private QueryPoint? _position;
    private string? _offsetParent;

    private async Task ToggleSlide() => await Query.Select(".slide-target").SlideToggle(TimeSpan.FromMilliseconds(600));

    private void ApplyStyle()
    {
        using (Query.BeginBatch())
        {
            Query.Select(".query-item").Eq(1).Css("color", "red");
            using (LayoutQuery.BeginBatch())
            {
                LayoutQuery.Select(".sidebar").Css("background", "black");
                LayoutQuery.Select(".top-row").Css("display", "none");
                LayoutQuery.Select(".page").Css("max-width", "1200px");
            }
        }

        _applied = true;
    }

    private async Task MeasureTargetAsync()
    {
        var target = Query.Select(".query-item").Eq(1);
        _measurement = (await target.WidthAsync(), await target.HeightAsync());
    }

    private async Task MeasurePositionAsync()
    {
        var target = Query.Select(".query-item").Eq(1);
        _offset = await target.OffsetAsync();
        _position = await target.PositionAsync();
        _offsetParent = await target.OffsetParentAsync();
    }
}
