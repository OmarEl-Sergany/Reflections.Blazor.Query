@page "/query-proof"
@rendermode InteractiveWebAssembly
@inject Reflections.Blazor.Query.Query Query

<QueryHost>
    <PageTitle>Query WebAssembly Proof</PageTitle>
    <h1>WebAssembly query proof</h1>
    <QueryElement TagName="p" ElementKey="wasm-query-proof-text" Class="query-proof-text">This text is unchanged until the button is clicked.</QueryElement>
    <button class="btn btn-primary" @onclick="ApplyStyle">Apply CSS</button>
    <button class="btn btn-outline-primary ms-2" @onclick="MeasureAsync">Measure target</button>
    @if (_applied)
    {
        <p role="status">Style applied in Interactive WebAssembly.</p>
    }
    @if (_width is not null)
    {
        <p role="status">Target width: @_width px.</p>
    }
</QueryHost>

@code {
    private bool _applied;
    private double? _width;

    private void ApplyStyle()
    {
        using (Query.BeginBatch())
        {
            Query.Select(".query-proof-text").Css("color", "red");
        }

        _applied = true;
    }

    private async Task MeasureAsync() =>
        _width = await Query.Select(".query-proof-text").WidthAsync();
}
