{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Reflections.Blazor.Query.csproj"
          ],
          "src": "../src/Reflections.Blazor.Query"
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0",
        "GenerateDocumentationFile": "true",
        "NoWarn": "1591"
      },
      "disableGitFeatures": true,
      "memberLayout": "samePage",
      "namespaceLayout": "nested"
    }
  ],
  "build": {
    "content": [
      "**/*.md",
      "**/toc.yml",
      "api/**/*.yml"
    ],
    "resource": [
      "images/**"
    ],
    "output": "_site",
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "template": [
      "default",
      "modern",
      "theme"
    ],
    "globalMetadata": {
      "_appTitle": "Reflections.Blazor.Query",
      "_appName": "Reflections.Blazor.Query",
      "_appLogoPath": "images/brand-mark.svg",
      "_appFaviconPath": "images/brand-mark.svg",
      "_appFooter": "<span>Blazor-native fluent element orchestration · .NET 10</span>",
      "_enableSearch": "true",
      "_enableNewTab": "true"
    },
    "disableGitFeatures": true
  }
}
